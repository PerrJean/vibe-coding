#!/bin/sh
# Hook de pre-commit du dépôt public vibe-coding : rien de personnel n'y entre.
# Secrets, chemins personnels, adresses e-mail, nom de l'auteur hors de
# LICENSE et termes des listes privées : voir .githooks/garde_publication.py.
# Activation, une fois par clone :
#   git config core.hooksPath .githooks
#   git config --add vibe.listes <chemin de chaque liste privée>
cd "$(git rev-parse --show-toplevel)" || exit 1
PYTHON=python
command -v python >/dev/null 2>&1 || PYTHON=python3
PYTHONIOENCODING=utf-8 $PYTHON .githooks/garde_publication.py --index || exit 1
echo "-> garde de publication : OK"
